# Développement local uniquement. setup.ps1 génère les secrets dans .env.
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
POSTGRES_DB=analog_finder
POSTGRES_USER=analog
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
